# Explicit opt-in. Ignored when NODE_ENV=production, even if set to mock.
IAM_ADAPTER=mock
NEXT_PUBLIC_APP_NAME=Bank CMS
# Live integration with identity-access-service (services/identity-access-service):
# IAM_ADAPTER=live
# IAM_API_BASE_URL=http://localhost:8000
# Development-only sign-in against the mock OIDC server (never enable in production):
# IAM_DEV_LOGIN=true
# IAM_DEV_TOKEN_URL=http://localhost:8081/default/token
# IAM_OIDC_ISSUER=http://localhost:8081/default
