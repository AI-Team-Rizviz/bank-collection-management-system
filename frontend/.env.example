# Explicit opt-in. Ignored when NODE_ENV=production, even if set to mock.
IAM_ADAPTER=mock
NEXT_PUBLIC_APP_NAME=Bank CMS
# Live integration with identity-access-service (services/identity-access-service).
# Users sign in on /login with a username and password; the IAM service verifies them.
# IAM_ADAPTER=live
# IAM_API_BASE_URL=http://localhost:8000
