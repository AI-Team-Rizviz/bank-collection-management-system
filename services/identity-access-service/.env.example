# Copy to .env (never commit .env). Special characters in passwords must be URL-encoded.
APP_NAME=identity-access-service
APP_ENV=development            # development | test | production
DATABASE_URL=postgresql+psycopg://iam_user:CHANGE_ME@localhost:5432/bank-cms
# Optional: separate DDL-capable role used only by Alembic (falls back to DATABASE_URL)
MIGRATION_DATABASE_URL=
DATABASE_SCHEMA=iam

# --- Login-form authentication (this service verifies passwords and signs its own access tokens) ---
# REQUIRED in production: a random secret of 32+ characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600
TOKEN_LEEWAY_SECONDS=30
# Token `sub` values that identify trusted internal services, comma separated
SERVICE_SUBJECTS=

# --- API ---
CORS_ALLOWED_ORIGINS=          # comma separated, empty = CORS disabled
ENABLE_API_DOCS=               # empty = on in development/test, off in production
AUTHZ_CACHE_TTL_SECONDS=60     # how long non-sensitive decisions may be cached by consumers
