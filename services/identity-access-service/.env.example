# Copy to .env (never commit .env). Special characters in passwords must be URL-encoded.
APP_NAME=identity-access-service
APP_ENV=development            # development | test | production
DATABASE_URL=postgresql+psycopg://iam_user:CHANGE_ME@localhost:5432/bank-cms
# Optional: separate DDL-capable role used only by Alembic (falls back to DATABASE_URL)
MIGRATION_DATABASE_URL=
DATABASE_SCHEMA=iam

# --- OIDC (required unless APP_ENV=development/test with the local mock provider) ---
OIDC_ISSUER=http://localhost:8081/default
OIDC_AUDIENCE=bank-cms-iam
OIDC_JWKS_URL=                 # optional; discovered from <issuer>/.well-known/openid-configuration when empty
OIDC_ALGORITHMS=RS256,ES256
OIDC_LEEWAY_SECONDS=30
# Token `sub` values that identify trusted internal services (client-credentials), comma separated
SERVICE_SUBJECTS=

# --- API ---
CORS_ALLOWED_ORIGINS=          # comma separated, empty = CORS disabled
ENABLE_API_DOCS=               # empty = on in development/test, off in production
AUTHZ_CACHE_TTL_SECONDS=60     # how long non-sensitive decisions may be cached by consumers
